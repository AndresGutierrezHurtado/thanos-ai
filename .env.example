# --- App
NODE_ENV=development
APP_NAME=Thanos AI
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# --- IA
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
AI_SPEECH_PROVIDER=openai

AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com   # Azure OpenAI; AI_*_MODEL = nombre del deployment
AZURE_OPENAI_API_KEY=

# --- GOOGLE INTEGRATION
GOOGLE_CLIENT_EMAIL=YOUR_GOOGLE_SERVICE_ACCOUNT_EMAIL
GOOGLE_PRIVATE_KEY="YOUR_GOOGLE_PRIVATE_KEY"
GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# --- PERSISTENCE
MONGO_USERNAME=thanos
MONGO_PASSWORD=contraseña
MONGODB_URI=mongodb://thanos:contraseña@localhost:27017
CHROMA_URL=http://localhost:8000
# Puerto del host (solo 127.0.0.1) donde docker compose publica Chroma; por defecto 8000
# CHROMA_HOST_PORT=8000

# --- MAILING SERVICE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_SECURE=false
SMTP_FROM=Thanos AI <noreply@tudominio.com>
