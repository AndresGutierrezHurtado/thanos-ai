{
    "name": "thanos_ai",
    "version": "1.0.0",
    "private": true,
    "description": "AI assistant for Platform Software Documentation",
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "clear && npm run dev -w server",
        "build": "npm run build -w client",
        "start": "npm start -w server",
        "lint": "npm run lint -w client",
        "sync:documents": "clear && npm run sync:documents -w server",
        "chroma:query": "clear && npm run chroma:query -w server",
        "docker:up": "clear && docker compose up -d --build",
        "docker:down": "clear && docker compose down"
    }
}
