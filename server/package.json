{
    "name": "thanos-ai-server",
    "version": "1.0.0",
    "description": "Backend for THANOS-AI",
    "main": "dist/index.ts",
    "scripts": {
        "dev": "tsx watch --exclude \"../client/**\" --env-file-if-exists=../.env src/index.ts",
        "start": "tsx --env-file-if-exists=../.env src/index.ts",
        "sync:documents": "tsx --env-file-if-exists=../.env src/presentation/cli/syncDocuments.ts",
        "chroma:query": "tsx --env-file-if-exists=../.env src/presentation/cli/chromaQuery.ts"
    },
    "keywords": [
        "thanos-ai",
        "backend",
        "typescript",
        "nodejs"
    ],
    "author": "Andrés Gutiérrez Hurtado",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@chroma-core/default-embed": "^0.1.9",
        "@langchain/core": "^1.1.18",
        "@langchain/ollama": "^1.3.0",
        "@langchain/openai": "^1.2.4",
        "bcrypt": "^6.0.0",
        "chromadb": "^3.2.2",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "googleapis": "^171.1.0",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.11.0",
        "mongodb": "^7.0.0",
        "next": "16.1.6",
        "nodemailer": "^8.0.1",
        "officeparser": "^6.0.4",
        "openai": "^6.17.0",
        "pdf-parse": "^2.4.5",
        "socket.io": "^4.8.3",
        "stream": "^0.0.3",
        "tsx": "^4.21.0",
        "wrt": "^0.0.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.9",
        "typescript": "^5.9.3"
    },
    "private": true
}
